default_model = "kimi-code/k3-256k"

[loop_control]
max_retries_per_step = 3
reserved_context_size = 50000
request_limit = 50

[thinking]
enabled = true
effort = "high"

[providers.deepseek]
type = "openai"
api_key = "sk-xxxxxxxxxxxxxxxx"
base_url = "https://api.deepseek.com"

[providers.xx]
type = "openai"
api_key = "sk-"
base_url = "https://xxx.dev/v1"

[models."xxx/gpt-5.6-luna"]
provider = "xxxx"
model = "gpt-5.6-luna"
max_context_size = 262144
capabilities = [ "thinking", "always_thinking", "image_in", "tool_use" ]
support_efforts = [ "low", "medium", "high", "xhigh", "max" ]
default_effort = "medium"
display_name = "GPT-5.6 Luna"

[models."deepseek/deepseek-v4-flash"]
provider = "deepseek"
model = "deepseek-v4-flash"
max_context_size = 1000000
max_output_size = 384000
capabilities = [ "thinking", "tool_use" ]
display_name = "DeepSeek V4 Flash"
reasoning_key = "reasoning_content"

[models."deepseek/deepseek-v4-pro"]
provider = "deepseek"
model = "deepseek-v4-pro"
max_context_size = 1000000
max_output_size = 384000
capabilities = [ "thinking", "tool_use" ]
display_name = "DeepSeek V4 Pro"
reasoning_key = "reasoning_content"

[secondary_model]
default_effort = "on"
model = "kimi-code/k3-256k"

[log]
log_level = "INFO"

# ---- 云端部署（springcloud 入口）----
# 留空整段则使用下列默认值；MySQL 库表由 alembic upgrade head 创建
[cloud]
# MySQL 连接串（PyMySQL 驱动）
database_url = "mysql+pymysql://root:root@127.0.0.1:3307/springharness?charset=utf8mb4"
# 云端数据根目录：工作区落在 {data_root}/workspaces/{user_id}/{session_id}
# 支持 ~ 开头（自动展开到家目录）
data_root = "~/.springharness/cloud"
# JWT 签名密钥与过期时间（分钟，10080 = 7 天）；生产必须改密钥
# 注意 HS256 密钥需 ≥32 字节（RFC 7518，Java jjwt 会强制校验）
jwt_secret = "springharness-dev-secret-0123456789abcd"
jwt_expire_minutes = 10080
# 监听地址与端口
host = "0.0.0.0"
port = 8001
